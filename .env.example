# Public browser configuration only. Do NOT put GEMINI_API_KEY here.
# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key. This is public browser configuration,
# not the service-role key.
VITE_SUPABASE_ANON_KEY=

# Optional override. If omitted, ChalkBox calls:
# ${VITE_SUPABASE_URL}/functions/v1/generate-topic-lesson
# VITE_TOPIC_GENERATION_ENDPOINT=
