# ============================================================
# ChalkBox root .gitignore
# ============================================================

# Dependencies
node_modules/

# Production builds
dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.local

# Local diagnostic outputs
textbook-audit-samples.txt

# Editor / OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Hosting / local platform state
.vercel/
.wrangler/
